# Copia este archivo a .env y rellena los valores. .env NO se sube a git ni a la imagen.

# --- DB local (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=EvalFlowDb
LOCAL_DB_PORT=5432

# --- DB remota (Neon), solo la usa scripts/sync-db-from-neon.sh ---
NEON_DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# --- Secretos de la API (mismos nombres que en Koyeb) ---
Jwt__Secret=
ApiKey=
Encryption__Key=
EmailSettings__SmtpUsername=
EmailSettings__SmtpPassword=
