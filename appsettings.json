{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "EvalFlowAPI",
    "Audience": "EvalFlowClients",
    "ExpirationInMinutes": 60
  },
  "EmailSettings": {
    "SenderName": "EvalFlow",
    "SenderEmail": "vexxenbrand@gmail.com"
  }
}
